# Environment: dev, staging, prod
ENVIRONMENT=dev

# Database
DATABASE_URL=postgresql+asyncpg://inbox_dev:inbox_dev_password@localhost:5432/inbox_dev

# API Server
API_HOST=localhost
API_PORT=8000
API_WORKERS=1

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-bytes
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key-generate-with-openssl-rand-32-b64

# Session
SESSION_ID_COOKIE_NAME=inbox_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_EXPIRY_DAYS=14

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-CSRF-Token

# CSRF
CSRF_HEADER_NAME=X-CSRF-Token

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=5

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-from-console.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI Pipeline (Phase 1)
# LLM Provider - Groq API
GROQ_API_KEY=your-groq-api-key-from-https://console.groq.com/keys
GROQ_MODEL_CLASSIFICATION=llama-3.1-8b-instant
GROQ_MODEL_DRAFTING=llama-3.3-70b-versatile

# AI Pipeline - Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_TOKENS_PER_MINUTE=10000
AI_MAX_RETRIES_ON_429=2

# AI Pipeline - Token Budgets
AI_TOKEN_BUDGET_CLASSIFICATION=600
AI_TOKEN_BUDGET_DRAFT=2500
AI_TOKEN_BUDGET_DAILY=100000

# AI Pipeline - Timeouts (seconds)
AI_LLM_TIMEOUT_SECONDS=30
AI_MCP_CALL_TIMEOUT_SECONDS=20
AI_MCP_STARTUP_TIMEOUT_SECONDS=5

# AI Pipeline - Versioning
AI_PROMPT_VERSION=v1
AI_MODEL_VERSION=phase-1

# AI Pipeline - Feature Flags
AI_ENABLE_STRUCTURED_OUTPUT=true
AI_ENABLE_RETRY_ON_PARSE_ERROR=true

# AI Pipeline - Batch Configuration
AI_BATCH_SIZE_CLASSIFICATION=5

# Sentry (optional, Phase 4)
SENTRY_DSN=

# Feature flags
DEMO_MODE_ENABLED=false
