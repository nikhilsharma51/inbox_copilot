ENV=dev

  # Google OAuth
  GOOGLE_CLIENT_ID=<your-google-client-id>
  GOOGLE_CLIENT_SECRET=<your-google-client-secret>
  OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

  # Database
  DATABASE_URL=postgresql://user:password@localhost:5432/inbox  # local docker
  DATABASE_URL_DIRECT=postgresql://user:password@localhost:5432/inbox

  # When using Neon:
  # DATABASE_URL=<neon-pooler-connection-string>
  # DATABASE_URL_DIRECT=<neon-direct-connection-string>

  # Secrets (generate these)
  SESSION_SECRET=d29728d75125df928cccb961a4e84fbbe26d555c510b68704c39967a2b691004
  TOKEN_ENCRYPTION_KEY=OuD7v4bRdgOp8d6AOoUCwG4dNED1YNcUTGBELCFjOUQ=
  TOKEN_KEY_VERSION=1
  MCP_JWT_SECRET=<generate-with: python -c "import secrets; print(secrets.token_hex(32))">
  APPROVAL_JWT_SECRET=<generate-with: python -c "import secrets; print(secrets.token_hex(32))">

  # Groq
  GROQ_API_KEY=<your-groq-api-key>

  # LLM Configuration
  MODEL_CLASSIFY=llama-3.1-8b-instant
  MODEL_DRAFT=llama-3.3-70b-versatile
  MODEL_JUDGE=mixtral-8x7b-32768
  MODEL_FALLBACK=openai/gpt-oss-20b

  # Budgets
  DAILY_TOKEN_BUDGET_USER=100000
  DAILY_TOKEN_BUDGET_GLOBAL=500000
  SEND_DAILY_CAP=20

  # Other
  UNDO_WINDOW_SECONDS=10
  EMBEDDED_WORKER=1
  DEMO_MODE_ENABLED=1
  CRON_SECRET=<generate-with: python -c "import secrets; print(secrets.token_hex(32))">
